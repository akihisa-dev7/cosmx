# ── CosMx Docker Compose environment ─────────────────────────────────────────
COMPOSE_PROJECT_NAME=cosmx2026

# Ports
GUI_PORT=8501

# Data paths (host-side; override as needed)
RAW_DATA_DIR=./raw_data
OUTPUTS_DIR=./outputs
OUTPUTS_SSD_DIR=./outputs_ssd
RESULTS_DIR=./results

# GPU device (use "all" or specific index e.g. "0")
NVIDIA_VISIBLE_DEVICES=all
